{
	"name": "bludemy/theme-name",
	"type": "wordpress-theme",
	"version": "1.0.0",
	"autoload": {
		"psr-4": {
		"Arvand\\": "vendor/arvand/"
		}
	},
	"config": {
		"preferred-install": "dist",
		"sort-packages": true,
		"optimize-autoloader": true,
		"allow-plugins": {
			"composer/installers": true
		}
    },
	"require": {
		"php": ">=7.4",
		"composer/installers": "^2.0"
	}
}
